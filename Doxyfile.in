# Reference documentation for the public interface: the headers in
# include/libthe-seed and the readme. Only the tags set here differ from the
# doxygen defaults. Generated by "make doxygen" into doxygen/html in the build
# directory.

PROJECT_NAME           = @PACKAGE_NAME@
PROJECT_NUMBER         = @PACKAGE_VERSION@
PROJECT_BRIEF          = "Engine runtime for The Seed"
OUTPUT_DIRECTORY       = @abs_top_builddir@/doxygen
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
INPUT                  = @abs_top_srcdir@/include/libthe-seed @abs_top_srcdir@/README.md
FILE_PATTERNS          = *.hpp
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = @abs_top_srcdir@/README.md
STRIP_FROM_PATH        = @abs_top_srcdir@/include @abs_top_srcdir@
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_FRIEND_COMPOUNDS  = YES
SOURCE_BROWSER         = NO
QT_AUTOBRIEF           = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_ID_STYLE      = GITHUB
# The export macro would otherwise hide the class names from the parser.
PREDEFINED             = THE_SEED_API=
# Headers forward-declare the plugin cache, which is not part of the interface.
EXCLUDE_SYMBOLS        = the_seed::internal*
HAVE_DOT               = YES
WARN_AS_ERROR          = NO
