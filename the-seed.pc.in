prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: @PACKAGE_NAME@
Description: Engine runtime for The Seed: plugin and scene loading, resource paks, dependency listing and signing
URL: @PACKAGE_URL@
Version: @PACKAGE_VERSION@
Requires: ecs-cpp >= @LIBECS_MIN_VERSION@
Libs: -L${libdir} -lthe-seed
Libs.private: @LIBS@
Cflags: -I${includedir} -std=c++20
